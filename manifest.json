{
  "manifest_version": 3,
  "name": "TimeLock",
  "version": "1.1.0",
  "description": "Tracks how long you spend on each website and locks you out of the ones you choose once you hit your daily limit.",
  "homepage_url": "https://github.com/jonpikereally/TimeLock",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "TimeLock",
    "default_popup": "app/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_idle" }],
  "permissions": ["storage", "alarms", "tabs", "idle", "notifications", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["app/blocked.html"], "matches": ["<all_urls>"] }]
}
